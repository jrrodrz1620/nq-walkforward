# Copy to .env (never commit .env) and fill in. Used by docker-compose.
# The shared secret your TradingView alert must include as "passphrase".
BOT_PASSPHRASE=change-me

# Execution backend: "stub" (mock, for testing) or "traderspost".
BOT_BROKER_TYPE=stub

# --- stub backend (only used when BOT_BROKER_TYPE=stub) ---
BOT_BROKER_URL=https://demo.tradovate.example/v1
BOT_BROKER_TOKEN=demo-token

# --- TradersPost backend (set BOT_BROKER_TYPE=traderspost to use) ---
# Your TradersPost webhook URL (Strategy → Webhook URL in the TradersPost UI).
# This is a secret — keep it only in .env, never commit it.
BOT_TRADERSPOST_WEBHOOK_URL=
# TradersPost doesn't report live equity on the webhook path; the margin
# guardrail runs off this value. Set it to your paper account's balance.
BOT_ACCOUNT_EQUITY=50000
# Protective stop distance in POINTS, attached to every order sent to
# TradersPost (0 = no stop). MES: 40 pts = $200. MNQ: 80 pts = $160.
BOT_STOP_LOSS_POINTS=0
# Take-profit distance in POINTS (0 = none). Some brokers reject a lone stop
# ("OTO not supported") and require a full bracket — set BOTH to use protective
# orders on those brokers. NOTE: adding a take-profit changes strategy behavior.
BOT_TAKE_PROFIT_POINTS=0

# HTTPS reverse proxy (Caddy). The domain must have a DNS A record pointing at
# the Droplet, and ports 80/443 must be open. Caddy auto-issues/renews the cert.
BOT_DOMAIN=bot.yourdomain.com
ACME_EMAIL=you@yourdomain.com
