# Copy to .env (never commit .env) and fill in. Used by docker-compose.
# The shared secret your TradingView alert must include as "passphrase".
BOT_PASSPHRASE=change-me

# Broker connection. Defaults point at the built-in STUB endpoint, which will
# fail-safe to error_log.json — replace with your real broker when going live.
BOT_BROKER_URL=https://demo.tradovate.example/v1
BOT_BROKER_TOKEN=demo-token

# HTTPS reverse proxy (Caddy). The domain must have a DNS A record pointing at
# the Droplet, and ports 80/443 must be open. Caddy auto-issues/renews the cert.
BOT_DOMAIN=bot.yourdomain.com
ACME_EMAIL=you@yourdomain.com
